# Production environment variables (set these in the Render dashboard, not here).
# Local development needs none of these — settings.py defaults keep SQLite +
# DEBUG=True working out of the box.
SECRET_KEY=generate-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=api.lasvacaciones.nl
FRONTEND_ORIGIN=https://lasvacaciones.nl
DATABASE_URL=postgres://user:password@host/dbname
